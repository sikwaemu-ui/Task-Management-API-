NODE_ENV=development
PORT=5000

# Required PostgreSQL Database Connection URL. Keep real credentials in deployment secrets.
DATABASE_URL="postgresql://username:password@localhost:5432/taskflow?sslmode=require"

# JWT Authentication: use a random secret with at least 32 characters in each environment.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="1d"

# Comma-separated exact browser origins. Leave the production value empty until
# the frontend's real origin is known. Local defaults are used outside production.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Trust only the verified number of reverse-proxy hops. Keep 0 until configured.
TRUST_PROXY_HOPS=0

# In-memory request rate limits (per process and client IP).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Graceful shutdown wait for HTTP and database cleanup, per phase.
SHUTDOWN_TIMEOUT_MS=10000
